<Window x:Class="StockTracker.PortfolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portfolio" Height="680" Width="1250" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="My Portfolio" FontSize="22" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,14,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Available cash"/><TextBox Text="{Binding Cash, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Cash reserve (%)"/><TextBox Text="{Binding CashReservePercentage, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Position limit (%)"/><TextBox Text="{Binding SinglePositionLimitPercentage, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,0"/></StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="Import CSV" Command="{Binding ImportCsvCommand}" Margin="0,0,8,0"/><Button Content="Refresh" Command="{Binding RefreshCommand}"/></StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SymbolInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Symbol, e.g. 2330" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantity" Margin="0,0,8,0"/>
            <TextBox Grid.Column="2" Text="{Binding AverageCostInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="Average cost" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="Add / Update" Command="{Binding AddHoldingCommand}" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}"/>
        </Grid>
        <DataGrid x:Name="HoldingGrid" Grid.Row="3" ItemsSource="{Binding Holdings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,8,0,8" MouseDoubleClick="HoldingGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="70"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N0}" Width="70"/><DataGridTextColumn Header="Avg. cost" Binding="{Binding AverageCost, StringFormat=N2}" Width="85"/>
                <DataGridTextColumn Header="Price" Binding="{Binding LatestPrice, StringFormat=N2}" Width="80"/><DataGridTextColumn Header="P/L" Binding="{Binding ProfitPercentage, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="80"/><DataGridTextColumn Header="Today" Binding="{Binding TodayChangePercentage, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="80"/><DataGridTextColumn Header="Market value" Binding="{Binding MarketValue, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight, StringFormat={}{0:F1}%}" Width="90"/><DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="65"/><DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="65"/>
                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="105"/><DataGridTextColumn Header="Action guidance" Binding="{Binding Guidance}" Width="300"/><DataGridTextColumn Header="Target" Binding="{Binding TargetWeight, StringFormat={}{0:F1}%}" Width="90"/>
                <DataGridTextColumn Header="Suggested amount" Binding="{Binding SuggestedTradeAmount, StringFormat=N0}" Width="120"/>
                <DataGridTemplateColumn Header=""><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Remove" Command="{Binding DataContext.RemoveHoldingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StockMarketValue, StringFormat=Stock value: {0:N0}}"/><TextBlock Grid.Column="1" Text="{Binding TotalAssets, StringFormat=Total assets: {0:N0}}"/><TextBlock Grid.Column="2" Text="{Binding CashRatio, StringFormat=Cash ratio: {0:F1}%}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>

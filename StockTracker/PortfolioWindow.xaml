<Window x:Class="StockTracker.PortfolioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x6211;&#x7684;&#x6295;&#x8CC7;&#x7D44;&#x5408;" Height="880" Width="1380" MinHeight="720" MinWidth="1050"
        WindowStartupLocation="CenterOwner" Background="#161B22">
    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173B57" Offset="0"/><GradientStop Color="#1E2A45" Offset="1"/></LinearGradientBrush>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#202832"/><Setter Property="BorderBrush" Value="#344354"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#1976D2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#42A5F5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2196F3"/></Trigger></Style.Triggers></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Background" Value="#2B3642"/><Setter Property="Foreground" Value="#D8E3F0"/><Setter Property="BorderBrush" Value="#45586B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="#9FB2C6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
        <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#F3F7FC"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263545"/><Setter Property="Foreground" Value="#AFC5DC"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="9,10"/><Setter Property="BorderBrush" Value="#344354"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#2C3845"/></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderGradient}" CornerRadius="12" Padding="20,16">
            <DockPanel>
                <StackPanel><TextBlock Text="&#x6211;&#x7684;&#x6295;&#x8CC7;&#x7D44;&#x5408;" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="&#x6301;&#x80A1;&#x3001;&#x73FE;&#x91D1;&#x6C34;&#x4F4D;&#x8207;&#x4F9D;&#x8A55;&#x5206;&#x7522;&#x751F;&#x7684;&#x518D;&#x5E73;&#x8861;&#x53C3;&#x8003;" Foreground="#B6CAE0" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"><Button x:Name="ToggleHoldingDetailsButton" Content="&#x96B1;&#x85CF;&#x80A1;&#x6578;" Click="ToggleHoldingDetails_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="&#x91CD;&#x65B0;&#x8A08;&#x7B97;" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="&#x5132;&#x5B58;&#x8B8A;&#x66F4;" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#x80A1;&#x7968;&#x5E02;&#x503C;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding StockMarketValue, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/><TextBlock Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"><Run Text="&#x7E3D;&#x6301;&#x80A1;&#x6BD4;&#x91CD;&#xFF1A;"/><Run Text="{Binding StockHoldingRatio, Mode=OneWay, StringFormat={}{0:F1}%}"/></TextBlock></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#x7E3D;&#x8CC7;&#x7522;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding TotalAssets, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/><TextBlock Text="&#x80A1;&#x7968;&#x5E02;&#x503C;&#x52A0;&#x4E0A;&#x53EF;&#x7528;&#x73FE;&#x91D1;" Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#x7D2F;&#x8A08;&#x6DE8;&#x6295;&#x5165;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding NetInvested, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/><TextBlock Text="&#x5165;&#x91D1;&#x6E1B;&#x51FA;&#x91D1;" Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#x7D2F;&#x8A08;&#x640D;&#x76CA;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding CumulativeProfitLoss, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"/><TextBlock Text="&#x7E3D;&#x8CC7;&#x7522;&#x6E1B;&#x6DE8;&#x6295;&#x5165;" Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource Panel}" Margin="0,0,10,0"><StackPanel><TextBlock Text="&#x640D;&#x76CA;&#x7387;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding CumulativeReturnPercentage, StringFormat={}{0:+0.00;-0.00;0.00}%}" Style="{StaticResource StatValue}"/><TextBlock Text="&#x4EE5;&#x7D2F;&#x8A08;&#x6DE8;&#x6295;&#x5165;&#x70BA;&#x57FA;&#x6E96;" Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Grid.Column="5" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="&#x73FE;&#x91D1;&#x6BD4;&#x91CD;" Style="{StaticResource FieldCaption}"/><TextBlock Text="{Binding CashRatio, StringFormat={}{0:F1}%}" Style="{StaticResource StatValue}"/><TextBlock Foreground="#7F94AA" FontSize="11" Margin="0,5,0,0"><Run Text="&#x6301;&#x80A1;&#x6A94;&#x6578;&#xFF1A;"/><Run Text="{Binding Holdings.Count, Mode=OneWay}"/></TextBlock></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="&#x53EF;&#x7528;&#x73FE;&#x91D1;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding Cash, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,12,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="&#x6700;&#x4F4E;&#x4FDD;&#x7559;&#x73FE;&#x91D1;&#xFF08;%&#xFF09;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding CashReservePercentage, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,12,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="&#x55AE;&#x4E00;&#x6301;&#x80A1;&#x4E0A;&#x9650;&#xFF08;%&#xFF09;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding SinglePositionLimitPercentage, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,12,0"/></StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="&#x532F;&#x5165; CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="&#x532F;&#x51FA; CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/><TextBlock Text="  &#x5305;&#x542B;&#x6301;&#x80A1;&#x3001;&#x8CC7;&#x91D1;&#x7570;&#x52D5;&#x8207;&#x6458;&#x8981;" Foreground="#7F94AA" VerticalAlignment="Center" FontSize="12"/></StackPanel>
        </Grid></Border>
        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="&#x8CC7;&#x91D1;&#x65E5;&#x671F;" Style="{StaticResource FieldCaption}"/><DatePicker SelectedDate="{Binding CashFlowDate}" Height="31" Margin="0,0,10,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="&#x985E;&#x578B;" Style="{StaticResource FieldCaption}"/><ComboBox SelectedValue="{Binding CashFlowType}" SelectedValuePath="Tag" Height="31" Margin="0,0,10,0"><ComboBoxItem Content="&#x5165;&#x91D1;" Tag="Deposit"/><ComboBoxItem Content="&#x51FA;&#x91D1;" Tag="Withdrawal"/></ComboBox></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="&#x91D1;&#x984D;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding CashFlowAmountInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,12,0"/></StackPanel>
            <Button Grid.Column="3" Content="&#x65B0;&#x589E;&#x8CC7;&#x91D1;&#x7570;&#x52D5;" Command="{Binding AddCashFlowCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="4" Text="&#x8ACB;&#x5148;&#x8A18;&#x9304;&#x521D;&#x59CB;&#x5165;&#x91D1;&#xFF1B;&#x4E4B;&#x5F8C;&#x7684;&#x5165;&#x91D1;&#x3001;&#x51FA;&#x91D1;&#x4E5F;&#x8ACB;&#x4F9D;&#x5BE6;&#x969B;&#x767B;&#x9304;&#x3002;&#x53EF;&#x5728;&#x4E0B;&#x65B9;&#x522A;&#x9664;&#x7570;&#x52D5;&#x7D00;&#x9304;&#x3002;" Foreground="#7F94AA" VerticalAlignment="Bottom" Margin="0,0,0,8" TextWrapping="Wrap"/>
        </Grid></Border>
        <Border Grid.Row="4" Style="{StaticResource Panel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="&#x80A1;&#x7968;&#x4EE3;&#x865F;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding SymbolInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="&#x4F8B;&#x5982; 2330" Height="31" Margin="0,0,10,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="&#x6301;&#x6709;&#x80A1;&#x6578;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,10,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="&#x5E73;&#x5747;&#x6210;&#x672C;" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding AverageCostInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,12,0"/></StackPanel>
            <Button Grid.Column="3" Content="&#x65B0;&#x589E;&#xFF0F;&#x66F4;&#x65B0;&#x6301;&#x80A1;" Command="{Binding AddHoldingCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="4" Text="{Binding StatusMessage}" Foreground="#9FB2C6" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </Grid></Border>
        <Border Grid.Row="5" Style="{StaticResource Panel}" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="85"/><ColumnDefinition Width="95"/><ColumnDefinition Width="85"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="75"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="交易日期" Style="{StaticResource FieldCaption}"/><DatePicker SelectedDate="{Binding TradeDate}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="類型" Style="{StaticResource FieldCaption}"/><ComboBox SelectedValue="{Binding TradeType}" SelectedValuePath="Tag" Height="31" Margin="0,0,8,0"><ComboBoxItem Content="買入" Tag="Buy"/><ComboBoxItem Content="賣出" Tag="Sell"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="代號" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding TradeSymbolInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="股數" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding TradeQuantityInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="成交價" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding TradePriceInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="手續費" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding TradeFeeInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="6"><TextBlock Text="交易稅" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding TradeTaxInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <Button Grid.Column="7" Content="新增交易" Command="{Binding AddTradeCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,0,4"><TextBlock Text="買入會更新平均成本與現金；賣出會計算已實現損益。" Foreground="#7F94AA" FontSize="11"/></StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="130"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="歷史損益日期" Style="{StaticResource FieldCaption}"/><DatePicker SelectedDate="{Binding AdjustmentDate}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="已實現損益" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding AdjustmentAmountInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="備註" Style="{StaticResource FieldCaption}"/><TextBox Text="{Binding AdjustmentNoteInput, UpdateSourceTrigger=PropertyChanged}" Height="31" Margin="0,0,8,0"/></StackPanel>
                <Button Grid.Column="3" Content="新增歷史損益" Command="{Binding AddRealizedAdjustmentCommand}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4"><TextBlock Text="已實現損益：" Foreground="#9FB2C6"/><TextBlock Text="{Binding RealizedProfitLoss, StringFormat={}{0:N0}}" Foreground="#F3F7FC" FontWeight="SemiBold"/><TextBlock Text="　未實現損益：" Foreground="#9FB2C6"/><TextBlock Text="{Binding UnrealizedProfitLoss, StringFormat={}{0:N0}}" Foreground="#F3F7FC" FontWeight="SemiBold"/></StackPanel>
            </Grid>
        </Grid></Border>
        <Border Grid.Row="6" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="16,14,16,10"><TextBlock Text="&#x8CC7;&#x91D1;&#x7570;&#x52D5;&#x7D00;&#x9304;" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="  &#x5165;&#x91D1;&#x70BA;&#x6B63;&#x3001;&#x51FA;&#x91D1;&#x70BA;&#x8CA0;&#xFF0C;&#x7528;&#x4F86;&#x8A08;&#x7B97;&#x7E3D;&#x8CC7;&#x7522;&#x5831;&#x916C;&#x7387;" Foreground="#8195AA" FontSize="12" VerticalAlignment="Bottom"/></DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding CashFlows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Height="118" AlternatingRowBackground="#1D2630" RowBackground="#202832" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="&#x65E5;&#x671F;" Binding="{Binding Date, Mode=OneWay, StringFormat=yyyy-MM-dd}" Width="150"/><DataGridTextColumn Header="&#x985E;&#x578B;" Binding="{Binding TypeName, Mode=OneWay}" Width="100"/><DataGridTextColumn Header="&#x91D1;&#x984D;" Binding="{Binding Amount, Mode=OneWay, StringFormat=N0}" Width="160"/><DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#x79FB;&#x9664;" Command="{Binding DataContext.RemoveCashFlowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="7,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            <DockPanel Grid.Row="2" Margin="16,14,16,10"><TextBlock Text="&#x6301;&#x80A1;&#x660E;&#x7D30;" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="  &#x96D9;&#x64CA;&#x5217;&#x9805;&#x958B;&#x555F;&#x80A1;&#x7968;&#x8A73;&#x60C5;" Foreground="#8195AA" FontSize="12" VerticalAlignment="Bottom"/></DockPanel>
            <DataGrid x:Name="HoldingGrid" Grid.Row="3" ItemsSource="{Binding Holdings}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MouseDoubleClick="HoldingGrid_OnMouseDoubleClick" AlternatingRowBackground="#1D2630" RowBackground="#202832" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x4EE3;&#x865F;" Binding="{Binding Symbol, Mode=OneWay}" Width="70"/><DataGridTextColumn Header="&#x540D;&#x7A31;" Binding="{Binding Name, Mode=OneWay}" Width="120"/><DataGridTextColumn x:Name="HoldingQuantityColumn" Header="&#x80A1;&#x6578;" Binding="{Binding Quantity, Mode=OneWay, StringFormat=N0}" Width="65"/><DataGridTextColumn x:Name="HoldingAverageCostColumn" Header="&#x5E73;&#x5747;&#x6210;&#x672C;" Binding="{Binding AverageCost, Mode=OneWay, StringFormat=N2}" Width="85"/>
                    <DataGridTextColumn Header="&#x73FE;&#x50F9;" Binding="{Binding LatestPrice, Mode=OneWay, StringFormat=N2}" Width="78"/>
                    <DataGridTemplateColumn Header="&#x6301;&#x80A1;&#x640D;&#x76CA;" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ProfitPercentage, StringFormat={}{0:+0.00;-0.00;0.00}%}" Foreground="{Binding ProfitPercentage, Converter={StaticResource ValueSignBrushConverter}}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="&#x4ECA;&#x65E5;&#x6F32;&#x8DCC;" Width="84"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TodayChangePercentage, StringFormat={}{0:+0.00;-0.00;0.00}%}" Foreground="{Binding TodayChangePercentage, Converter={StaticResource ValueSignBrushConverter}}" FontWeight="SemiBold"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="&#x5E02;&#x503C;" Binding="{Binding MarketValue, Mode=OneWay, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="&#x76EE;&#x524D;&#x6B0A;&#x91CD;" Binding="{Binding Weight, Mode=OneWay, StringFormat={}{0:F1}%}" Width="75"/><DataGridTextColumn Header="&#x5206;&#x6578;&#xFF0F;&#x98A8;&#x96AA;" Binding="{Binding ScoreRiskText, Mode=OneWay}" Width="80"/><DataGridTextColumn Header="&#x5EFA;&#x8B70;&#x52D5;&#x4F5C;" Binding="{Binding Recommendation, Mode=OneWay}" Width="105"/><DataGridTextColumn Header="&#x64CD;&#x4F5C;&#x8AAA;&#x660E;" Binding="{Binding Guidance, Mode=OneWay}" Width="*"/><DataGridTextColumn Header="&#x76EE;&#x6A19;&#x6B0A;&#x91CD;" Binding="{Binding TargetWeight, Mode=OneWay, StringFormat={}{0:F1}%}" Width="72"/><DataGridTextColumn Header="&#x53C3;&#x8003;&#x91D1;&#x984D;" Binding="{Binding SuggestedTradeAmount, Mode=OneWay, StringFormat=N0}" Width="95"/>
                    <DataGridTemplateColumn Header="" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#x79FB;&#x9664;" Command="{Binding DataContext.RemoveHoldingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButton}" Padding="7,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid></Border>
    </Grid>
</Window>



<Window x:Class="StockTracker.RankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全市場推薦排名" Height="760" Width="1280" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppForegroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="全市場股票掃描與排名" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" />

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
                <StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="16" />
                    <TextBlock Text="{Binding ProgressText}" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border Visibility="Collapsed" Width="220" HorizontalAlignment="Right" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,10,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#24066;&#22580;&#24291;&#24230;&#20736;&#34920;&#26495;" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,3" />
                    <Grid Width="160" Height="160" Margin="0,8,0,6">
                        <Path Data="{Binding MarketBreadth.AdvancingArc}" Stroke="IndianRed" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{Binding MarketBreadth.DecliningArc}" Stroke="MediumSeaGreen" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{Binding MarketBreadth.UnchangedArc}" Stroke="#8b949e" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MarketBreadth.MarketTone}" FontSize="16" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding MarketBreadth.AdvanceRatioPercent, StringFormat={}{0:F0}%}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MarketBreadth.AdvancingCount, StringFormat=↑ {0:N0}}" Foreground="IndianRed" FontWeight="SemiBold" Margin="4,0" />
                        <TextBlock Text="{Binding MarketBreadth.DecliningCount, StringFormat=↓ {0:N0}}" Foreground="MediumSeaGreen" FontWeight="SemiBold" Margin="4,0" />
                        <TextBlock Text="{Binding MarketBreadth.UnchangedCount, StringFormat=— {0:N0}}" Foreground="#8b949e" FontWeight="SemiBold" Margin="4,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding MarketBreadth.AverageChangePercent, StringFormat=平均 {0:+0.00;-0.00;0.00}%}" FontSize="11" Foreground="{Binding MarketBreadth.MarketToneBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <UniformGrid Columns="6" Visibility="Collapsed">
                        <StackPanel><TextBlock Text="上漲家數" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.AdvancingCount}" FontSize="19" FontWeight="Bold" Foreground="IndianRed" /></StackPanel>
                        <StackPanel><TextBlock Text="下跌家數" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.DecliningCount}" FontSize="19" FontWeight="Bold" Foreground="MediumSeaGreen" /></StackPanel>
                        <StackPanel><TextBlock Text="平盤家數" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.UnchangedCount}" FontSize="19" FontWeight="Bold" Foreground="#8b949e" /></StackPanel>
                        <StackPanel><TextBlock Text="上漲比例" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.AdvanceRatioPercent, StringFormat={}{0:F1}%}" FontSize="19" FontWeight="Bold" Foreground="White" /></StackPanel>
                        <StackPanel><TextBlock Text="平均漲跌" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.AverageChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}%}" FontSize="19" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" /></StackPanel>
                        <StackPanel><TextBlock Text="市場氣氛" FontSize="11" Foreground="#8b949e" /><TextBlock Text="{Binding MarketBreadth.MarketTone}" FontSize="19" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" /></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="&#26063;&#32676;&#27683;&#27675;" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    <Button DockPanel.Dock="Right" Content="&#39023;&#31034;&#20840;&#37096;" Padding="8,3" Command="{Binding ClearMarketGroupFilterCommand}" Visibility="{Binding IsMarketGroupFilterActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMarketGroup}" Foreground="#8b949e" Margin="0,3,8,0" />
                </DockPanel>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding TopMarketGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="156" Background="#21262d" BorderBrush="{Binding DirectionBrush}" BorderThickness="2" CornerRadius="4" Padding="7,5" Margin="0,0,8,8">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" Foreground="White" /><TextBlock Text="{Binding DirectionText}" DockPanel.Dock="Right" Foreground="{Binding DirectionBrush}" FontWeight="Bold" /></DockPanel>
                                    <DockPanel Margin="0,3,0,0"><TextBlock Text="{Binding AverageChangePercent, StringFormat={}{0:+0.00;-0.00;0.00}%}" FontSize="16" FontWeight="Bold" Foreground="{Binding DirectionBrush}" /><TextBlock DockPanel.Dock="Right" Text="{Binding AdvancingCount, StringFormat=↑ {0:N0}}" Foreground="IndianRed" FontSize="11" Margin="5,2,0,0" /><TextBlock DockPanel.Dock="Right" Text="{Binding DecliningCount, StringFormat=↓ {0:N0}}" Foreground="MediumSeaGreen" FontSize="11" Margin="5,2,0,0" /></DockPanel>
                                    <Button Content="篩選此族群" FontSize="10" Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Right" Command="{Binding DataContext.FilterMarketGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding GroupName}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 0050 Market Leader Summary Card - Compact Version -->
        <Border Grid.Row="2" Margin="0,0,0,10" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" Padding="12" CornerRadius="6"
                Visibility="{Binding Has0050Data, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="Auto" MinWidth="200"/>
                    <ColumnDefinition Width="*" MinWidth="250"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Basic Info -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="📊 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Stock0050.Symbol}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Stock0050.Name}" FontSize="14" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Stock0050.LatestPrice, StringFormat='{}{0:F2}'}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding Stock0050.ChangePercent, StringFormat='{}{0:+0.00;-0.00;0.00}%'}" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="{Binding Stock0050.ChangePercentBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Stock0050.Rank, StringFormat='排名 #{0}'}" FontSize="10" Foreground="#8b949e"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="分數 " FontSize="10" Foreground="#8b949e"/>
                                <TextBlock Text="{Binding Stock0050.Score}" FontSize="14" FontWeight="Bold" Foreground="White" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Middle: Institutional Trading -->
                <Border Grid.Column="1" Background="#21262d" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="法人買賣超(張)" FontSize="10" FontWeight="SemiBold" Foreground="#6e7681" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="外資" FontSize="10" Foreground="#8b949e" Margin="0,0,0,3"/>
                                <TextBlock Text="投信" FontSize="10" Foreground="#8b949e" Margin="0,0,0,3"/>
                                <TextBlock Text="自營" FontSize="10" Foreground="#8b949e"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Stock0050.ForeignNetDisplay}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{Binding Stock0050.ForeignNetBrush}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Stock0050.TrustNetDisplay}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{Binding Stock0050.TrustNetBrush}" HorizontalAlignment="Right" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Stock0050.DealerNetDisplay}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{Binding Stock0050.DealerNetBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Right: Strategy & Trend -->
                <Border Grid.Column="2" Background="#21262d" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="策略建議" FontSize="10" FontWeight="SemiBold" Foreground="#6e7681" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="White">
                                <Run Text="{Binding Stock0050.StrategyActionText, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=" | " Foreground="#6e7681"/>
                                <Run Text="{Binding Stock0050.StrategyStageLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Stock0050.Suggestion}" FontSize="10" Foreground="#8b949e" 
                                       TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="5日均" FontSize="9" Foreground="#6e7681" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Stock0050.AverageRecentScore, StringFormat='{}{0:F1}'}" 
                                       FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Stock0050.ScoreTrend, StringFormat='趨勢 {0:+0;-0;0}'}" 
                                       FontSize="9" Foreground="{Binding Stock0050.ChangePercentBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="12" CornerRadius="6">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Content="{Binding ControlPanelToggleText}" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,0,8,0" Command="{Binding ToggleControlPanelCommand}"/>
                    <Button Content="手動更新網站" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,0,8,0" Command="{Binding PublishWebsiteCommand}"/>
                    <Button Content="Export CSV" Width ="120" Height="30" HorizontalAlignment="Left" Margin="0,0,8,0" Command="{Binding ToggleExportCsvCommand}" />
                    <TextBlock Text="通知 Email 清單" VerticalAlignment="Center" Margin="4,0,8,0" />
                    <TextBox Text="{Binding NotificationEmailList, UpdateSourceTrigger=PropertyChanged}" Width="420" Height="30" VerticalContentAlignment="Center" />
                </WrapPanel>
                    <Border Grid.Column="1" Width="176" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" CornerRadius="6" Padding="8" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Viewbox Width="70" Height="70" Grid.Column="0">
                                <Grid Width="160" Height="160">
                                    <Path Data="{Binding MarketBreadth.AdvancingArc}" Stroke="IndianRed" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="{Binding MarketBreadth.DecliningArc}" Stroke="MediumSeaGreen" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="{Binding MarketBreadth.UnchangedArc}" Stroke="#8b949e" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Text="{Binding MarketBreadth.AdvanceRatioPercent, StringFormat={}{0:F0}%}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="&#24066;&#22580;&#24291;&#24230;" FontSize="12" Foreground="#8b949e" />
                                <TextBlock Text="{Binding MarketBreadth.MarketTone}" FontSize="16" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" />
                                <TextBlock Text="{Binding MarketBreadth.AdvancingCount, StringFormat=&#8593; {0:N0}}" FontSize="11" Foreground="IndianRed" />
                                <TextBlock Text="{Binding MarketBreadth.DecliningCount, StringFormat=&#8595; {0:N0}}" FontSize="11" Foreground="MediumSeaGreen" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding ControlPanelVisibility}">
                <Border Visibility="Collapsed" Width="220" HorizontalAlignment="Left" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#24066;&#22580;&#24291;&#24230;" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="&#26412;&#27425;&#36617;&#20837;&#27161;&#30340;" FontSize="10" Foreground="#8b949e" HorizontalAlignment="Center" />
                        <Grid Width="160" Height="160" Margin="0,8,0,6">
                            <Path Data="{Binding MarketBreadth.AdvancingArc}" Stroke="IndianRed" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{Binding MarketBreadth.DecliningArc}" Stroke="MediumSeaGreen" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{Binding MarketBreadth.UnchangedArc}" Stroke="#8b949e" StrokeThickness="16" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MarketBreadth.MarketTone}" FontSize="16" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MarketBreadth.AdvanceRatioPercent, StringFormat={}{0:F0}%}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MarketBreadth.AdvancingCount, StringFormat=↑ {0:N0}}" Foreground="IndianRed" FontWeight="SemiBold" Margin="4,0" />
                            <TextBlock Text="{Binding MarketBreadth.DecliningCount, StringFormat=↓ {0:N0}}" Foreground="MediumSeaGreen" FontWeight="SemiBold" Margin="4,0" />
                            <TextBlock Text="{Binding MarketBreadth.UnchangedCount, StringFormat=— {0:N0}}" Foreground="#8b949e" FontWeight="SemiBold" Margin="4,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding MarketBreadth.AverageChangePercent, StringFormat=平均 {0:+0.00;-0.00;0.00}%}" FontSize="11" Foreground="{Binding MarketBreadth.MarketToneBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,0,0,10">
                    <Border Visibility="Collapsed" Width="190" Background="#1a1d23" BorderBrush="#3a4553" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#24066;&#22580;&#24291;&#24230;" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                            <Grid Width="128" Height="128" Margin="0,5,0,4">
                                <Path Data="{Binding MarketBreadth.AdvancingArc}" Stroke="IndianRed" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="{Binding MarketBreadth.DecliningArc}" Stroke="MediumSeaGreen" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="{Binding MarketBreadth.UnchangedArc}" Stroke="#8b949e" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MarketBreadth.MarketTone}" FontSize="14" FontWeight="Bold" Foreground="{Binding MarketBreadth.MarketToneBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding MarketBreadth.AdvanceRatioPercent, StringFormat={}{0:F0}%}" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MarketBreadth.AdvancingCount, StringFormat=↑ {0:N0}}" Foreground="IndianRed" FontSize="11" FontWeight="SemiBold" Margin="3,0" />
                                <TextBlock Text="{Binding MarketBreadth.DecliningCount, StringFormat=↓ {0:N0}}" Foreground="MediumSeaGreen" FontSize="11" FontWeight="SemiBold" Margin="3,0" />
                                <TextBlock Text="{Binding MarketBreadth.UnchangedCount, StringFormat=— {0:N0}}" Foreground="#8b949e" FontSize="11" FontWeight="SemiBold" Margin="3,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="掃描與顯示" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <TextBlock Text="排名數量" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding TopCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="開始掃描" Width="90" Height="30" Command="{Binding StartScanningCommand}" Margin="0,0,8,0"/>
                                <Button Content="清除條件" Width="90" Height="30" Command="{Binding ClearFiltersCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="快速條件" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="強勢連高分" Width="96" Height="30" Command="{Binding ApplyStrongMomentumFilterCommand}" Margin="0,0,8,0"/>
                                <Button Content="低價高分" Width="86" Height="30" Command="{Binding ApplyLowPriceHighScoreFilterCommand}" Margin="0,0,8,0"/>
                                <Button Content="法人同步買超" Width="110" Height="30" Command="{Binding ApplyInstitutionalMomentumFilterCommand}" Margin="0,0,8,0"/>
                                <Button Content="分數翻揚" Width="86" Height="30" Command="{Binding ApplyScoreReboundFilterCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="本機族群維護" FontWeight="SemiBold" />
                            <Button DockPanel.Dock="Right" Content="{Binding GroupEditorToggleText}" Padding="8,3" Command="{Binding ToggleGroupEditorCommand}" />
                            <Button DockPanel.Dock="Right" Content="刪除目前族群" Padding="8,3" Command="{Binding DeleteGroupCommand}" />
                            <TextBlock DockPanel.Dock="Right" Text="僅桌面版可編輯；網站僅供瀏覽。" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,12,0" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding GroupEditorVisibility}">
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="族群名稱" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding GroupEditorGroups}" IsEditable="True" Text="{Binding GroupEditorName, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="股票代號" Margin="0,0,0,4" />
                                <TextBox Text="{Binding GroupEditorSymbol, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="28" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="股票名稱（選填）" Margin="0,0,0,4" />
                                <TextBox Text="{Binding GroupEditorStockName, UpdateSourceTrigger=PropertyChanged}" Width="150" Height="28" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <Button Content="新增股票至族群" Width="120" Height="30" Margin="0,20,0,0" Command="{Binding AddStockToGroupCommand}" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding GroupEditorStocks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="150" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="代號" Binding="{Binding Symbol}" Width="100" />
                                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="產業" Binding="{Binding Industry}" Width="180" />
                                <DataGridTemplateColumn Header="操作" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="移除股票" Padding="6,2" Command="{Binding DataContext.RemoveStockFromGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <WrapPanel Margin="0,0,0,10">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="基本篩選" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="搜尋代號/名稱" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="價格區間" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <TextBox Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                        <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="漲跌幅(%)" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <TextBox Text="{Binding MinChangePercentFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                        <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Text="{Binding MaxChangePercentFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="三大法人買賣超" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <TextBox Text="{Binding MinThreeMajorNetFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="28" VerticalContentAlignment="Center" />
                                        <TextBlock Text="~" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Text="{Binding MaxThreeMajorNetFilter, UpdateSourceTrigger=PropertyChanged}" Width="90" Height="28" VerticalContentAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="分數條件" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="連續天數" Margin="0,0,0,4" />
                                    <WrapPanel>
                                        <TextBox Text="{Binding MinConsecutiveDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" VerticalContentAlignment="Center" />
                                        <TextBlock Text="天，分數 ≥" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Text="{Binding MinConsecutiveScore, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="28" VerticalContentAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="最新分數 ≥" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MinLatestScoreFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="風險分數 ≦" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MinCrashRiskScoreFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="型態標籤數 ≥" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MinPatternTagCountFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="指定型態" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PatternTagOptions}" SelectedItem="{Binding SelectedPatternTag, Mode=TwoWay}" Width="150" Height="28"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="策略動作" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding StrategyActionOptions}" SelectedItem="{Binding SelectedStrategyAction, Mode=TwoWay}" Width="150" Height="28"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="建議倉位" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding StrategyHoldingOptions}" SelectedItem="{Binding SelectedStrategyHolding, Mode=TwoWay}" Width="150" Height="28"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="建議" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SuggestionOptions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" Width="150" Height="28"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8">
                                    <TextBlock Text="近5日均分 ≥" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MinAverageScoreFilter, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,8" VerticalAlignment="Bottom">
                                    <TextBlock Text="趨勢條件" Margin="0,0,0,4" />
                                    <CheckBox Content="近5日分數趨勢上升" IsChecked="{Binding RequireScoreTrendUp}" VerticalAlignment="Center" />
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4" PreviewMouseDoubleClick="DataGrid_PreviewMouseDoubleClick" ItemsSource="{Binding RankedStocksView}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                  Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceAltBrush}" AlternatingRowBackground="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AppForegroundBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="60" />
                <DataGridTextColumn Header="代號" Binding="{Binding Symbol}" Width="80" />
                <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="最新價" Binding="{Binding LatestPrice, StringFormat=F2}" Width="80" />
                <DataGridTextColumn Header="漲跌幅(%)" Binding="{Binding ChangePercent, StringFormat=F2}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding ChangePercentBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="分數" Binding="{Binding Score}" Width="80" />
                <DataGridTextColumn Header="分數日期" Binding="{Binding ScoreDateText}" Width="95" />
                <DataGridTextColumn Header="風險分" Binding="{Binding CrashRiskScore}" Width="70" />
                <DataGridTextColumn Header="型態數" Binding="{Binding PatternTagCount}" Width="60" />
                <DataGridTextColumn Header="型態" Binding="{Binding PatternTagsText}" Width="180" />
                <DataGridTextColumn Header="{Binding DataContext.ScoreDay0Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ScoreDay0}" Width="55" />
                <DataGridTextColumn Header="{Binding DataContext.ScoreDay1Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ScoreDay1}" Width="55" />
                <DataGridTextColumn Header="{Binding DataContext.ScoreDay2Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ScoreDay2}" Width="55" />
                <DataGridTextColumn Header="{Binding DataContext.ScoreDay3Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ScoreDay3}" Width="55" />
                <DataGridTextColumn Header="{Binding DataContext.ScoreDay4Header, RelativeSource={RelativeSource AncestorType=DataGrid}}" Binding="{Binding ScoreDay4}" Width="55" />
                <DataGridTextColumn Header="近5日均分" Binding="{Binding AverageRecentScore, StringFormat=F1}" Width="80" />
                <DataGridTextColumn Header="趨勢" Binding="{Binding ScoreTrend}" Width="60" />
                <DataGridTextColumn Header="三大法人買賣超" Binding="{Binding NetDisplay}" SortMemberPath="ThreeMajorNet" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding NetDisplayBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="三大法人買賣超金額" Binding="{Binding NetAmountDisplay}" SortMemberPath="ThreeMajorNetAmount" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding NetAmountDisplayBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="策略動作" Binding="{Binding StrategyActionText}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding StrategyActionBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="線性倉位" Binding="{Binding StrategyStageLabel}" Width="130"/>
                <DataGridTextColumn Header="建議" Binding="{Binding Suggestion}" Width="150" />
            </DataGrid.Columns>
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DataGrid.Resources>
        </DataGrid>
    </Grid>
</Window>
